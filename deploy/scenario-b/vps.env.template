# Copy this file to .env on the VPS and replace every required placeholder.
APP_PORT=3000

MYSQL_DATABASE=okulblog
MYSQL_USER=okulblog
MYSQL_PASSWORD=replace-with-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-different-long-random-root-password

JWT_SECRET=replace-with-at-least-32-random-characters
VITE_APP_TITLE=OkulBlog
VITE_APP_LOGO=
VITE_APP_ID=replace-with-oauth-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
OWNER_OPEN_ID=replace-with-owner-open-id
OWNER_NAME=replace-with-owner-name
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=replace-with-server-only-key
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Empty means same-origin API (/api/trpc), correct for Scenario B.
VITE_API_BASE_URL=

# Provider keys are entered later in Admin > Integration Settings.
# Never commit the populated .env file.
