# Vite build-time variables. These values are embedded into the static bundle.
VITE_API_BASE_URL=https://api.example.com
VITE_APP_TITLE=OkulBlog
VITE_APP_LOGO=
VITE_APP_ID=replace-with-public-oauth-app-id
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Never put DATABASE_URL, JWT_SECRET, OAuth client secret or provider API keys here.
