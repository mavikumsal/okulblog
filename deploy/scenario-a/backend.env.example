# Node.js API / Express + tRPC
NODE_ENV=production
PORT=3000

# MySQL/TiDB connection string
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME

# Session and Manus OAuth
JWT_SECRET=replace-with-at-least-32-random-characters
VITE_APP_ID=replace-with-oauth-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
OWNER_OPEN_ID=replace-with-owner-open-id
OWNER_NAME=replace-with-owner-name

# Built-in API services used by the application
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=replace-with-server-only-key

# Optional public metadata / analytics values used by the frontend build
VITE_APP_TITLE=OkulBlog
VITE_APP_LOGO=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Configure these in the Admin Integration Settings after first login.
# Do not commit real Google, AI, Bunny.net, S3 or Search Console secrets.
